# Puerto local (Railway lo inyecta solo, no hace falta definirlo alla)
PORT=3000

# Dominios que pueden llamar a esta API, separados por coma
CORS_ORIGINS=https://www.yoryopkrk.cl,https://yoryopkrk.cl,http://localhost:4200

# Postgres (Railway te da esta variable automaticamente al agregar el plugin de Postgres;
# en Supabase: Project Settings > Database > Connection string > URI)
POSTGRES_URL=postgresql://usuario:password@host:5432/railway
POSTGRES_SSL=true
# Esquema a usar (por defecto "public"). Util si compartes un mismo proyecto de
# Supabase entre varios backends, cada uno con su propio esquema.
POSTGRES_SCHEMA=public

# Resend (resend.com) envia los correos via su API HTTP en vez de SMTP directo,
# porque varios hostings (Render incluido) bloquean las conexiones SMTP salientes.
# Consigue la API key en resend.com > API Keys.
RESEND_API_KEY=
# Direccion remitente. Si no verificas tu propio dominio en Resend, usa el dominio
# de pruebas que ellos dan (funciona de inmediato, sin configurar nada):
MAIL_FROM=onboarding@resend.dev
# A donde llega el aviso de "nuevo mensaje"
MAIL_TO=jor.sanchezv.90@gmail.com

# Header x-api-key requerido para leer/editar/borrar contactos guardados.
# Genera algo largo y aleatorio, por ejemplo con: openssl rand -hex 32
ADMIN_API_KEY=
